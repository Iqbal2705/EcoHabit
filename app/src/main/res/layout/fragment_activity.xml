<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bgutama">


    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarActivity"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="#DDEEDC"
        app:navigationIcon="@drawable/left"
        app:title=""
        app:menu="@menu/main_menu"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />



    <LinearLayout
        android:id="@+id/headerActivity"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintTop_toBottomOf="@id/toolbarActivity"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


    <TextView
            android:id="@+id/txtActivityTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pilih Aktivitas"
            android:textColor="#1F5D42"
            android:textSize="24sp"
            android:textStyle="bold"
            android:fontFamily="@font/poppins" />

        <TextView
            android:id="@+id/txtActivitySubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Mulai kebiasaan baik untuk lingkungan."
            android:textColor="#66756C"
            android:textSize="12sp"
            android:fontFamily="@font/poppins" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupKategori"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:chipSpacingHorizontal="8dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSemua"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="Semua"
                    android:fontFamily="@font/poppins"
                    android:textSize="12sp"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_filter_background"
                    app:chipStrokeColor="#4F9D69"
                    app:chipStrokeWidth="1dp"
                    app:chipCornerRadius="20dp"
                    android:textColor="@color/chip_filter_text" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSampah"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="Sampah"
                    android:fontFamily="@font/poppins"
                    android:textSize="12sp"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_filter_background"
                    app:chipStrokeColor="#4F9D69"
                    app:chipStrokeWidth="1dp"
                    app:chipCornerRadius="20dp"
                    android:textColor="@color/chip_filter_text" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEnergi"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="Energi"
                    android:fontFamily="@font/poppins"
                    android:textSize="12sp"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_filter_background"
                    app:chipStrokeColor="#4F9D69"
                    app:chipStrokeWidth="1dp"
                    app:chipCornerRadius="20dp"
                    android:textColor="@color/chip_filter_text" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAir"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="Air"
                    android:fontFamily="@font/poppins"
                    android:textSize="12sp"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_filter_background"
                    app:chipStrokeColor="#4F9D69"
                    app:chipStrokeWidth="1dp"
                    app:chipCornerRadius="20dp"
                    android:textColor="@color/chip_filter_text" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTransportasi"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="Transportasi"
                    android:fontFamily="@font/poppins"
                    android:textSize="12sp"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_filter_background"
                    app:chipStrokeColor="#4F9D69"
                    app:chipStrokeWidth="1dp"
                    app:chipCornerRadius="20dp"
                    android:textColor="@color/chip_filter_text" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipKebiasaanHijau"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="Kebiasaan Hijau"
                    android:fontFamily="@font/poppins"
                    android:textSize="12sp"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_filter_background"
                    app:chipStrokeColor="#4F9D69"
                    app:chipStrokeWidth="1dp"
                    app:chipCornerRadius="20dp"
                    android:textColor="@color/chip_filter_text" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>
    </LinearLayout>

    <ListView
        android:id="@+id/listViewActivity"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:background="@android:color/transparent"
        android:divider="@android:color/transparent"
        android:dividerHeight="10dp"
        android:clipToPadding="false"
        android:paddingTop="2dp"
        android:paddingBottom="12dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/headerActivity"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
