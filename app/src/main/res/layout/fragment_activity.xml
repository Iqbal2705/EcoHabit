<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bgutama">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarActivity"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="#DDEEDC"
        app:navigationIcon="@drawable/left"
        app:title=""
        app:menu="@menu/main_menu"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/headerActivity"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/toolbarActivity"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/txtActivityTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pilih Aktivitas"
            android:textColor="#1F5D42"
            android:textSize="24sp"
            android:textStyle="bold"
            android:fontFamily="@font/poppins" />

        <TextView
            android:id="@+id/txtActivitySubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Mulai kebiasaan baik untuk lingkungan."
            android:textColor="#66756C"
            android:textSize="12sp"
            android:fontFamily="@font/poppins" />

    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayoutActivity"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:background="#DDEEDC"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabTextColor="#66756C"
        app:tabSelectedTextColor="#1F5D42"
        app:tabIndicatorColor="#1F5D42"
        app:tabIndicatorHeight="3dp"
        app:layout_constraintTop_toBottomOf="@id/headerActivity"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerActivity"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/tabLayoutActivity"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
