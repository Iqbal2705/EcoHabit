<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bgutama"
    tools:context=".Home.HomeFragment">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarMain"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="#DDEEDC"
        app:title=""
        app:menu="@menu/main_menu"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="false"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toBottomOf="@id/toolbarMain"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="20dp">

            <TextView
                android:id="@+id/txtGreeting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Halo, Iqbal! 🌿"
                android:textColor="#1F5D42"
                android:textSize="21sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Terus jaga kebiasaan baikmu\ndemi bumi yang lebih hijau"
                android:textColor="#66756C"
                android:textSize="12sp"
                android:fontFamily="@font/poppins" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="112dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#DDEEDC"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="82dp"
                        android:layout_height="82dp"
                        android:contentDescription="Tanaman Level 3"
                        android:scaleType="fitCenter"
                        android:src="@drawable/tnmnlevel" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Level 3"
                            android:textColor="#1F5D42"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Pecinta Lingkungan"
                            android:textColor="#4F9D69"
                            android:textSize="12sp"
                            android:fontFamily="@font/poppins" />

                        <ProgressBar
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:layout_marginTop="10dp"
                            android:max="250"
                            android:progress="200"
                            android:progressTint="#4F9D69"
                            android:progressBackgroundTint="#B9D8B8" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:layout_marginTop="3dp"
                            android:text="200 / 250 XP"
                            android:textColor="#4F9D69"
                            android:textSize="10sp"
                            android:fontFamily="@font/poppins" />

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Aktivitas Hari Ini"
                android:textColor="#1F5D42"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins" />

            <!-- Aktivitas tumbler -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="#DDEEDC"
                app:cardCornerRadius="17dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:contentDescription="Ikon tumbler"
                        android:scaleType="fitCenter"
                        android:src="@drawable/tumbler" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Bawa Tumbler Sendiri"
                            android:textColor="#173B2B"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="+ 10 Point"
                            android:textColor="#4F9D69"
                            android:textSize="11sp"
                            android:fontFamily="@font/poppins" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/checkTumbler"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/unchecked"
                        android:scaleType="fitCenter"
                        android:contentDescription="Status aktivitas tumbler" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Aktivitas lampu -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="#DDEEDC"
                app:cardCornerRadius="17dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:contentDescription="Ikon lampu"
                        android:scaleType="fitCenter"
                        android:src="@drawable/light" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Matikan Lampu"
                            android:textColor="#173B2B"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="+ 10 Point"
                            android:textColor="#4F9D69"
                            android:textSize="11sp"
                            android:fontFamily="@font/poppins" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/checkLampu"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/unchecked"
                        android:scaleType="fitCenter"
                        android:contentDescription="Status aktivitas lampu" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Aktivitas pilah sampah -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="#DDEEDC"
                app:cardCornerRadius="17dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:contentDescription="Ikon daur ulang"
                        android:scaleType="fitCenter"
                        android:src="@drawable/recycle" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pilah Sampah"
                            android:textColor="#173B2B"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="+ 10 Point"
                            android:textColor="#4F9D69"
                            android:textSize="11sp"
                            android:fontFamily="@font/poppins" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/checkSampah"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/unchecked"
                        android:scaleType="fitCenter"
                        android:contentDescription="Status aktivitas pilah sampah" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Kartu challenge -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardChallenge"
                android:layout_width="match_parent"
                android:layout_height="132dp"
                android:layout_marginTop="28dp"
                app:cardBackgroundColor="#DDEEDC"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Yuk, Ikuti Challenge!"
                            android:textColor="#1F5D42"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Kurangi Sampah"
                            android:textColor="#1F5D42"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Selama 7 Hari     ›"
                            android:textColor="#4F9D69"
                            android:textSize="12sp"
                            android:fontFamily="@font/poppins" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:contentDescription="Tanaman Challenge"
                        android:scaleType="fitCenter"
                        android:src="@drawable/tnmnchallange" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
