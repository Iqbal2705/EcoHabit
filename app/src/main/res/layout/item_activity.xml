<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="18dp"
    app:cardElevation="3dp"
    app:strokeColor="#E5E5E5"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="76dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/imgActivityIcon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:contentDescription="Ikon aktivitas"
            android:scaleType="fitCenter"
            android:src="@drawable/recycle" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtActivityName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sampah"
                android:textColor="#1F5D42"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins" />

            <TextView
                android:id="@+id/txtActivityDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Kelola sampah dengan bijak"
                android:textColor="#858585"
                android:textSize="11sp"
                android:fontFamily="@font/poppins" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:text="›"
            android:textColor="#1F5D42"
            android:textSize="30sp"
            android:textStyle="bold" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
