<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bgutama">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarChallenge"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="#DDEEDC"
        app:navigationIcon="@drawable/left"
        app:title=""
        app:menu="@menu/main_menu"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="false"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/toolbarChallenge"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingBottom="20dp">

            <!-- Judul -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Challenge"
                android:textColor="#1F5D42"
                android:textSize="23sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Selesaikan Misi Agar Menjadi Lebih Baik"
                android:textColor="#66756C"
                android:textSize="11sp"
                android:fontFamily="@font/poppins" />

            <!-- Gambar Tantangan -->
            <ImageView
                android:id="@+id/imgChallengeHero"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_stat_card"
                android:src="@drawable/challenge_tumbler"
                android:scaleType="centerCrop"
                android:contentDescription="Tantangan membawa tumbler"
                android:clipToOutline="true" />

            <!-- Nama Tantangan -->
            <TextView
                android:id="@+id/txtChallengeTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Bawa Tumbler Pribadi"
                android:textColor="#1F5D42"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins" />

            <TextView
                android:id="@+id/txtChallengeDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Mengurangi penggunaan botol plastik sekali pakai dengan membawa tumbler pribadi dapat membantu mengurangi sampah plastik dan menjaga lingkungan."
                android:textColor="#66756C"
                android:textSize="11sp"
                android:lineSpacingExtra="2dp"
                android:fontFamily="@font/poppins" />

            <!-- Kartu Tips -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_stat_card"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:text="🌿"
                    android:textSize="25sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tips"
                        android:textColor="#1F5D42"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Gunakan tumbler setiap bepergian, ke kampus atau saat di luar."
                        android:textColor="#66756C"
                        android:textSize="10sp"
                        android:fontFamily="@font/poppins" />

                </LinearLayout>
            </LinearLayout>

            <!-- Target Mingguan -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_stat_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Target Mingguan"
                    android:textColor="#1F5D42"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins" />

                <TextView
                    android:id="@+id/txtTargetChallenge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="3 dari 7 Hari"
                    android:textColor="#1F5D42"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins" />

                <ProgressBar
                    android:id="@+id/progressChallenge"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="7dp"
                    android:layout_marginTop="8dp"
                    android:max="7"
                    android:progress="3"
                    android:progressTint="#1F5D42"
                    android:progressBackgroundTint="#D9D9D9" />

            </LinearLayout>

            <!-- Tombol Selesai -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelesaikanChallenge"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:text="✓  Tandai Sebagai Selesai"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins"
                android:backgroundTint="#1F5D42"
                app:cornerRadius="30dp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
